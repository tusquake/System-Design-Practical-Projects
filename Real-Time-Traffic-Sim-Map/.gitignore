# ──────────────────────────────────────────────
# Real-Time Traffic Sim Map – .gitignore
# ──────────────────────────────────────────────

# ── Java / Maven (backend) ──────────────────
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear

# ── Python (simulator) ──────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.venv
.venv/
venv/
env/
.env

# ── Node.js / Vite (frontend) ───────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── Environment & secrets ───────────────────
.env
.env.local
.env.*.local
*.secret

# ── Docker ──────────────────────────────────
.docker/

# ── IDEs & editors ──────────────────────────
.idea/
*.iml
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
